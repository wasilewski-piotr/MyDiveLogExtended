<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:icon="@mipmap/ds_launcher"
        android:roundIcon="@mipmap/ds_launcher_round"
        android:label="My Dive Log Design System">
        <activity
            android:name=".design.app.MyDiveLogDesignActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".design.app.DSButtonPreviewActivity"/>
        <activity android:name=".design.app.DSNavigationPreviewActivity"/>
        <activity android:name=".design.app.DSCardPreviewActivity"/>
        <activity android:name=".design.app.DSProgressPreviewActivity"/>
        <activity android:name=".design.app.DSTextPreviewActivity"/>

        <activity android:name=".design.app.dialogs.DSDialogsPreviewActivity"/>
        <activity android:name=".design.app.dialogs.date.DSDatePickerDialogPreviewActivity"/>
        <activity android:name=".design.app.dialogs.alert.DSAlertDialogPreviewActivity"/>

        <activity android:name=".design.app.inputs.DSInputsPreviewActivity"/>
        <activity android:name=".design.app.inputs.text.DSTextInputPreviewActivity"/>
        <activity android:name=".design.app.inputs.date.DSDateInputPreviewActivity"/>

        <activity android:name=".design.app.states.DSStatesPreviewActivity"/>
        <activity android:name=".design.app.states.empty.DSEmptyStatePreviewActivity"/>
        <activity android:name=".design.app.states.error.DSErrorStatePreviewActivity"/>
        <activity android:name=".design.app.states.error.DSErrorStateFullScreenPreviewActivity"/>
        <activity android:name=".design.app.states.error.DSErrorStatesFullScreenPreviewActivity"/>
        <activity android:name=".design.app.states.success.DSSuccessStateFullScreenPreviewActivity"/>
        <activity android:name=".design.app.states.success.DSSuccessStatesFullScreenPreviewActivity"/>
    </application>
</manifest>
